<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(TfmGroupDotNet)</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Parse and render JASS source files.</Description>
		<PackageTags>jass;modding;parser;warcraft3;wc3</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<ProjectReference Include="..\War3Net.CodeAnalysis\War3Net.CodeAnalysis.csproj" />
		<ProjectReference Include="..\War3Net.Common\War3Net.Common.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<PackageReference Include="War3Net.CodeAnalysis" />
		<PackageReference Include="War3Net.Common" />
	</ItemGroup>

</Project>
